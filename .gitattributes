# 统一按 LF 入库。这个项目要在 Windows / Linux / macOS 上都能构建，
# 而 shell 脚本一旦带 CRLF，Linux 上会报 "bad interpreter: /bin/bash^M"，
# 且 scripts/build.js 用 execSync('bash scripts/patch-cli.sh') 调它，会连带构建失败。
* text=auto eol=lf

*.sh    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.ts    text eol=lf
*.vue   text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# 二进制：不要做任何行尾/文本转换
*.png   binary
*.jpg   binary
*.amr   binary
